# Copia a .env solo si vas a sobreescribir el Compose.
# Railway CLI: token de workspace → RAILWAY_API_TOKEN= (no RAILWAY_TOKEN). Token de proyecto → RAILWAY_TOKEN=
# El CLI a menudo falla con tokens rlwy_wksp_; la API GraphQL sí puede usarlos.
# La clave local de Postgres del Compose es de desarrollo. Cámbiala antes de publicar.

# Railway puede entregar postgresql://. La API lo acepta igual.
DATABASE_URL=postgresql+psycopg://eternova:eternova@postgres:5432/eternova
# API (backend): orígenes públicos del front, separados por coma.
CORS_ORIGINS=http://localhost,https://eternova-production.up.railway.app
# Correo de contacto (backend). Requerido: SMTP_HOST + CONTACT_TO.
SMTP_HOST=
SMTP_PORT=587
# Puerto 465: SMTP_USE_SSL=true. Gmail/Outlook en 587: SMTP_USE_TLS=true (por defecto).
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USER=
SMTP_PASSWORD=
# Dirección visible en "De:" (idealmente el mismo dominio que SMTP_USER).
SMTP_FROM=
CONTACT_TO=
# Front: URL de la API FastAPI (servidor, no expuesta al navegador).
API_URL=http://backend:8000
# Railway (servicio front): API_URL=http://${{eternova-api.RAILWAY_PRIVATE_DOMAIN}}:${{eternova-api.PORT}}
# o la URL pública https://tu-api.up.railway.app
# URL pública (https). En Railway puedes usar https://${{RAILWAY_PUBLIC_DOMAIN}}
NEXT_PUBLIC_SITE_URL=http://localhost
# Opcional: Search Console — etiqueta HTML (método alternativo al archivo .html).
GOOGLE_SITE_VERIFICATION=
# Opcional: Google Analytics 4. Solo se carga si el visitante acepta todas las cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
