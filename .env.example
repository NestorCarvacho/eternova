# Copia a .env solo si vas a sobreescribir el Compose.
# La clave local de Postgres del Compose es de desarrollo. Cámbiala antes de publicar.

# Railway puede entregar postgresql://. La API lo acepta igual.
DATABASE_URL=postgresql+psycopg://eternova:eternova@postgres:5432/eternova
CORS_ORIGINS=http://localhost
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_TO=
API_URL=http://backend:8000
NEXT_PUBLIC_SITE_URL=http://localhost
# Opcional: Google Analytics 4. Solo se carga si el visitante acepta todas las cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
